			count: 2
			path: app/Http/Controllers/AdministradorController.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: app/Http/Controllers/AdministradorController.php

		-
			message: '#^Loose comparison using \!\= between true and null will always evaluate to true\.$#'
			identifier: notEqual.alwaysTrue
			count: 1
			path: app/Http/Controllers/AdministradorController.php

		-
			message: '#^Parameter \#1 \$horario of static method App\\Models\\Horario\:\:editarHorarios\(\) expects App\\Models\\Horario, Illuminate\\Database\\Eloquent\\Model given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/AdministradorController.php

		-
			message: '#^Parameter \#3 \$imagen_public_id of static method App\\Models\\Noticias\:\:createNoticia\(\) expects int, string given\.$#'
			identifier: argument.type
